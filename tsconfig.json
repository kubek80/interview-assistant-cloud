{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "e2e", "playwright.config.ts"],
  // The browser app. The server has its own project (server/tsconfig.json).
  // Excluded until steps 2 and 3 port them (step 2b ported the live interview, the candidate window and the scorecard) to the HTTP data layer (README "Porting a screen"):
  // the local app's IndexedDB layer, its end-to-end tests, and the screens that still use it.
  "exclude": [
    "src/db-local",
    "e2e-local",
    "src/ai",
    "src/pages/Debrief.tsx",
    "src/pages/Comparison.tsx",
    "src/pages/Summary.tsx",
    "src/pages/CandidateSummary.tsx",
    "src/pages/admin/AiAdmin.tsx",
    "src/pages/admin/BankAdmin.tsx",
    "src/pages/admin/Privacy.tsx",
    "src/pages/compare",
    "src/pages/dashboard/Sessions.tsx",
    "src/pages/team/Attendance.tsx",
    "src/pages/interview/InterviewersDialog.tsx",
    "src/pages/scorecard/AiSection.tsx",
    "src/pages/debrief",
    "src/pages/panel",
    "src/pages/summary",
    "src/pages/transcript"
  ]
}
