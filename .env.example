# Interview Assistant (hosted) — every setting the server reads (HOST-3).
# Copy to .env for local development (`npm run dev` reads it; .env is git-ignored).
# In Google Cloud these are Cloud Run environment variables; the ones marked SECRET come from
# Secret Manager (docs/deploy/README.md). Never commit real secrets.

# ---- Required ----

# PostgreSQL connection. Local: the dev database from `npm run db:start`.
# Cloud Run + Cloud SQL (unix socket): postgres://ia_app@/interview_assistant?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=postgres://ia@127.0.0.1:54329/ia_dev

# SECRET. Database password, when it is not in DATABASE_URL (it should not be in production).
# DB_PASSWORD=

# SECRET. At least 32 random characters; keys the session hashes. `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-for-development-only

# The address people open, origin only (no path). Used for the Google redirect URI and the CSRF
# origin check. Development with `npm run dev`: the Vite dev server's address.
PUBLIC_URL=http://localhost:5173

# Administrators who can always sign in (AUTH-3): comma-separated emails. Required in production.
BOOTSTRAP_ADMINS=admin@example.test

# ---- Google sign-in (AUTH-1). Required in production; both or neither. ----
# OAuth client of type "Web application"; authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# SECRET.
# GOOGLE_CLIENT_SECRET=

# ---- Development only ----
# Development sign-in (AUTH-6): pick a user without Google. The server refuses to start with it in production.
DEV_SIGN_IN=true

# ---- Optional ----
# NODE_ENV=production            # production turns on HSTS and the production checks above
# PORT=8080                      # Cloud Run sets this
# HOST=127.0.0.1                 # default 0.0.0.0 in production
# SESSION_IDLE_HOURS=12          # AUTH-4: sessions end after this long without use
# SESSION_MAX_DAYS=7             # and in any case after this long
# TRUST_PROXY=true               # default true in production (Cloud Run's front end sets X-Forwarded-For)
# DATABASE_POOL_MAX=10           # connections per instance; keep instances × this below Cloud SQL's limit
# LIVE_STREAM_MAX_MINUTES=15     # live-update streams end and reconnect after this long (below the request timeout)
# LOG_LEVEL=info
# STATIC_DIR=dist/client         # the built browser app
# MIGRATIONS_DIR=server/db/migrations
# SEED_DIR=seed
