{
  "name": "interview-assistant-cloud",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch --clear-screen=false server/main.ts",
    "dev:client": "vite",
    "build": "npm run typecheck && vite build && vite build --config vite.server.config.ts",
    "start": "node dist/server/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "e2e": "playwright test --trace off",
    "validate:seed": "node scripts/validate-seed.mjs",
    "gen:schema": "node scripts/gen-track-validator.mjs",
    "db:start": "sh scripts/dev-db.sh start",
    "db:stop": "sh scripts/dev-db.sh stop",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "db:import-questions": "tsx server/cli.ts import-questions",
    "db:dev-users": "tsx server/cli.ts dev-users"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "ajv": "8.20.0",
    "fastify": "5.12.8",
    "kysely": "0.28.20",
    "openid-client": "6.9.1",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@tanstack/react-query": "5.108.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dompurify": "3.5.0",
    "jose": "6.2.18",
    "marked": "18.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
